# Copy this file to .env and fill in the values. Real environment variables take priority.
# Never commit .env: it holds passwords.

# Network: 0.0.0.0 lets other machines reach the app; 127.0.0.1 keeps it on this machine only
# (With Docker, HOST and PORT are set by docker-compose.yml; APP_PORT is the port opened on the server.)
HOST=0.0.0.0
PORT=8000
APP_PORT=8000

# Time zone for ticket times shown in the app and in emails (Docker only; without Docker the server's own time zone is used)
TZ=Asia/Kolkata

# Link put in notification emails: the address other people use to open the app
APP_URL=http://127.0.0.1:8000

# Signs login tokens; use a long random string. Changing it logs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Admin account created on the very first start (only when no admin exists yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# PostgreSQL (docker-compose.yml reads the POSTGRES_* values; the app uses DATABASE_URL)
# With Docker, DATABASE_URL is built automatically from the POSTGRES_* values.
# Keep the password to letters and numbers: @ : / # in it would break DATABASE_URL.
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://servicedesk:change-me@127.0.0.1:5434/servicedesk

# SMTP (leave SMTP_USER/SMTP_PASS empty to print emails in the console instead)
# Microsoft 365 / Outlook: smtp.office365.com, port 587, an app password
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# People the admin picks from when assigning a ticket (comma-separated)
TEAM_EMAILS=
